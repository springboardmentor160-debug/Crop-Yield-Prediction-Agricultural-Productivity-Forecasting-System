# Copy this file to `.env` in the same folder and adjust values as needed.
# .env is loaded automatically by app.py (via python-dotenv).
# Never commit your real .env file -- only .env.example should be in version control.

# SQLite database file (relative to backend/ when the server starts)
DATABASE_URL=sqlite:///yieldsense.db

# Used later for password hashing / sessions / tokens (Step 3+).
# Change this to any random string before you rely on it for real security.
SECRET_KEY=dev-secret-key-change-me

# Origin allowed to call the API during local development.
# This must match the URL Vite prints when you run `npm run dev`.
FRONTEND_ORIGIN=http://localhost:5173
